---
import { Picture } from 'astro:assets';
import site from '../data/site.json';
import { resolveImage } from '../lib/images';
import { i18nAttrs } from '../lib/i18n';
import T from './T.astro';
import Doodle from './Doodle.astro';

const { story } = site;
---

<section class="section story" id="story" aria-labelledby="story-title" data-story>
  <div class="container story-grid">
    <div class="story-visual">
      <div class="story-photo arch" data-story-photo>
        <Picture
          src={resolveImage(story.image)}
          formats={['avif', 'webp']}
          widths={[360, 540, 760]}
          sizes="(min-width: 900px) 40vw, 80vw"
          loading="lazy"
          {...i18nAttrs({ alt: story.imageAlt })}
        />
      </div>
      <p class="story-tag" aria-hidden="true">{story.baker}</p>
      <Doodle name="heart" class="d-heart" />
      <Doodle name="wheat" class="d-wheat" />
    </div>

    <div class="story-text" data-story-text>
      <p class="eyebrow"><T v={story.eyebrow} /></p>
      <h2 class="section-title" id="story-title"><T v={story.title} /></h2>
      <p class="story-body"><T v={story.body} /></p>
      <p class="story-sign"><T v={story.signature} /></p>
      <dl class="facts">
        {
          story.facts.map((fact) => (
            <div class="fact">
              <dt>
                <T v={fact.label} />
              </dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
    align-items: center;
  }
  .story-visual {
    position: relative;
    width: min(82%, 380px);
    margin-inline: auto;
  }
  .story-photo {
    aspect-ratio: 5 / 6;
    border: 6px solid var(--surface-strong);
    transform: rotate(-1.5deg);
  }
  .story-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story-tag {
    position: absolute;
    right: -8%;
    bottom: 10%;
    padding: 0.35rem 1.1rem 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1;
    transform: rotate(-6deg);
    box-shadow: var(--shadow);
  }
  .d-heart {
    width: 46px;
    top: -4%;
    left: -10%;
    color: var(--berry);
    opacity: 0.75;
    transform: rotate(-14deg);
  }
  .d-wheat {
    width: 70px;
    bottom: -6%;
    left: -12%;
    transform: rotate(-30deg);
  }
  .story-body {
    margin-top: 1.25rem;
    font-size: clamp(1.06rem, 2.4vw, 1.18rem);
    line-height: 1.75;
  }
  .story-sign {
    margin-top: 1.1rem;
    font-family: var(--font-script);
    font-size: 1.6rem;
    color: var(--brand);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 1.75rem 0 0;
  }
  .fact {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.1rem;
    flex: 1 1 9rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--heading);
  }
  .fact dt {
    font-size: 0.88rem;
    color: var(--text-soft);
  }
  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .story-visual {
      width: min(100%, 420px);
    }
  }
</style>
