---
// Real customer messages, laid out as little chat windows (masonry columns).
// Bubbles keep the original Indonesian; English mode adds an italic translation.
import site from '../data/site.json';
import type { Localized } from '../lib/i18n';
import T from './T.astro';
import Doodle from './Doodle.astro';

interface Message {
  from: 'them' | 'us';
  time: string;
  text: string;
  en?: string;
}
interface Item {
  name: string;
  note: Localized;
  messages: Message[];
}

const { testimonials } = site;
const items = testimonials.items as Item[];
const tones = ['honey', 'berry', 'wood', 'brand'];
---

<section class="section words" aria-labelledby="words-title">
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow"><T v={testimonials.eyebrow} /></p>
      <h2 class="section-title" id="words-title"><T v={testimonials.title} /></h2>
      <p class="section-intro"><T v={testimonials.intro} /></p>
    </div>

    <div class="words-wrap">
      <Doodle name="quote" class="d-quote" />
      <Doodle name="heart" class="d-heart" />

      <ul class="chats" role="list">
        {
          items.map((item, i) => (
            <li class="chat-item" data-reveal-item>
              <figure class="chat">
                <figcaption class="chat-bar">
                  <span class={`avatar tone-${tones[i % tones.length]}`} aria-hidden="true">
                    {item.name.charAt(0)}
                  </span>
                  <span class="chat-who">
                    <span class="chat-name">{item.name}</span>
                    <span class="chat-note">
                      <T v={item.note} />
                    </span>
                  </span>
                  <svg class="chat-wa" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z" />
                  </svg>
                </figcaption>
                <blockquote class="chat-body">
                  {item.messages.map((msg) => (
                    <p class={`bubble from-${msg.from}`}>
                      {msg.from === 'us' && <span class="sr-only">{testimonials.us}: </span>}
                      <span class="bubble-text">{msg.text}</span>
                      {msg.en && (
                        <span class="i18n bubble-tr" lang="en">
                          {msg.en}
                        </span>
                      )}
                      <span class="bubble-meta" aria-hidden="true">
                        {msg.time}
                        {msg.from === 'us' && (
                          <svg viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6.5l3 3L10 3M7 9.5L13 3" /></svg>
                        )}
                      </span>
                    </p>
                  ))}
                </blockquote>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .words {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--bg-alt) 70%, transparent), transparent);
  }
  .words-wrap {
    position: relative;
  }
  .d-quote {
    top: -2.2rem;
    left: -0.4rem;
    width: 56px;
    color: var(--accent);
    opacity: 1;
  }
  .d-heart {
    right: 0;
    bottom: -2rem;
    width: 48px;
    color: var(--berry);
    opacity: 0.55;
  }

  .chats {
    columns: 1;
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chat-item {
    break-inside: avoid;
    padding-bottom: 1.5rem;
  }
  .chat {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-strong);
    box-shadow:
      inset 0 0 0 1px var(--line),
      var(--shadow);
  }
  .chat-item:nth-child(3n + 1) .chat {
    transform: rotate(-0.7deg);
  }
  .chat-item:nth-child(3n + 2) .chat {
    transform: rotate(0.6deg);
  }

  /* top bar, like a chat header */
  .chat-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff8ee;
  }
  .tone-honey {
    background: var(--accent-strong);
    color: var(--accent-ink);
  }
  .tone-berry {
    background: var(--berry);
  }
  .tone-wood {
    background: var(--wood);
    color: var(--accent-ink);
  }
  .tone-brand {
    background: var(--brand);
    color: var(--bg);
  }
  .chat-who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    line-height: 1.25;
  }
  .chat-name {
    font-weight: 800;
    color: var(--heading);
  }
  .chat-note {
    font-size: 0.82rem;
    color: var(--text-soft);
  }
  .chat-wa {
    flex: none;
    width: 20px;
    height: 20px;
    color: #25a35a;
    opacity: 0.85;
  }

  /* conversation */
  .chat-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 1rem 0.9rem 1.1rem;
    background-color: var(--bg-alt);
    background-image: radial-gradient(color-mix(in srgb, var(--wood) 22%, transparent) 1px, transparent 1.4px);
    background-size: 16px 16px;
  }
  .bubble {
    display: flow-root;
    position: relative;
    max-width: 86%;
    padding: 0.5rem 0.75rem 0.4rem;
    border-radius: 16px;
    font-size: 0.98rem;
    line-height: 1.45;
    box-shadow: var(--shadow-sm);
  }
  .from-them {
    align-self: flex-start;
    border-top-left-radius: 4px;
    background: var(--surface-strong);
    color: var(--text);
  }
  .from-us {
    align-self: flex-end;
    border-top-right-radius: 4px;
    background: color-mix(in srgb, var(--accent) 30%, var(--surface-strong));
    color: var(--text);
  }
  .from-them + .from-them,
  .from-us + .from-us {
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
  }
  .from-them + .from-them {
    border-top-left-radius: 6px;
  }
  .from-us + .from-us {
    border-top-right-radius: 6px;
  }
  .bubble-text {
    overflow-wrap: anywhere;
  }
  .bubble-tr {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-soft);
  }
  .bubble-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    float: right;
    margin: 0.35rem 0 0 0.6rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-soft);
    opacity: 0.8;
  }
  .bubble-meta svg {
    width: 15px;
    height: 10px;
    color: #3a9bd6;
  }

  @media (min-width: 700px) {
    .chats {
      columns: 2;
    }
  }
  @media (min-width: 1050px) {
    .chats {
      columns: 3;
    }
  }
</style>
