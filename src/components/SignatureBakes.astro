---
import site from '../data/site.json';
import { getFeatured } from '../lib/products';
import T from './T.astro';
import Doodle from './Doodle.astro';
import ProductCard from './ProductCard.astro';
import ProductModal from './ProductModal.astro';

const featured = getFeatured();
const { bakes } = site;
---

<section class="section bakes" id="bakes" aria-labelledby="bakes-title">
  <Doodle name="rolling-pin" class="d-pin" />
  <Doodle name="sprinkles" class="d-sprinkle" />
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow"><T v={bakes.eyebrow} /></p>
      <h2 class="section-title" id="bakes-title"><T v={bakes.title} /></h2>
      <p class="section-intro"><T v={bakes.intro} /></p>
    </div>

    <ul class="bakes-grid" role="list">
      {
        featured.map((product) => (
          <li data-reveal-item>
            <ProductCard product={product} />
          </li>
        ))
      }
    </ul>
  </div>
  {featured.map((product) => <ProductModal product={product} />)}
</section>

<style>
  .bakes {
    overflow-x: clip;
  }
  /* Flex (not grid) so an incomplete last row stays centred when the menu has an odd number of items. */
  .bakes-grid {
    --gap: clamp(0.8rem, 3vw, 1.75rem);
    --cols: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bakes-grid > li {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    min-width: 0;
  }
  .d-pin {
    width: 76px;
    top: 1.25rem;
    left: -1.25rem;
    transform: rotate(-12deg);
  }
  .d-sprinkle {
    width: 64px;
    right: 0.25rem;
    top: 1.5rem;
    color: var(--berry);
    opacity: 0.6;
  }
  @media (min-width: 1000px) {
    .bakes-grid {
      --cols: 3;
    }
    .d-pin {
      top: 2.5rem;
      left: 4%;
      width: 150px;
    }
    .d-sprinkle {
      top: 5rem;
      right: 8%;
      width: 80px;
    }
  }
</style>
