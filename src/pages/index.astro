---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SignatureBakes from '../components/SignatureBakes.astro';
import DisplayCase from '../components/DisplayCase.astro';
import OurStory from '../components/OurStory.astro';
import KindWords from '../components/KindWords.astro';
import OrderCTA from '../components/OrderCTA.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <SignatureBakes />
    <DisplayCase />
    <OurStory />
    <KindWords />
    <OrderCTA />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Base>

<script>
  import '../scripts/main';
</script>
