  "story": {
    "eyebrow": { "id": "Kenalan dengan baker-nya", "en": "Meet the baker" },
    "title": { "id": "Cerita Kami", "en": "Our Story" },
    "baker": "Phillip",
    "body": {
      "id": "Phillip jatuh cinta pada dunia baking saat kuliah Seni Kuliner di Universitas Pradita di masa pandemi, ketika dapur menjadi tempat favoritnya. Sejak lulus tahun 2023 ia terus memanggang, dan setelah dua tahun menjalankan Philpanicio dari rumah, kini ia siap berkembang — tetap membuat setiap roti dan kue dengan tangan, untuk orang-orang yang ia kenal dan sayangi.",
      "en": "Phillip discovered his love for baking while studying Culinary Arts at Universitas Pradita during the pandemic, when the kitchen became his happy place. He's been baking professionally since graduating in 2023, and after two years of running Philpanicio from home, he's growing — still shaping every loaf and frosting every cake by hand, for the people he knows and loves."
    },
    "signature": { "id": "— Phillip, baker", "en": "— Phillip, baker" },
    "image": "story/placeholder-baker-phillip.jpg",
    "imageAlt": {
      "id": "Ilustrasi Phillip mengenakan celemek sambil membawa kue cokelat",
      "en": "Illustration of Phillip in his apron holding a chocolate cake"
    },
    "facts": [
      { "value": "2023", "label": { "id": "mulai memanggang profesional", "en": "baking professionally since" } },
      { "value": "100%", "label": { "id": "dibuat dengan tangan", "en": "made by hand" } }
    ]
  },
